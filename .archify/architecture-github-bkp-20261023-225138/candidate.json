  "cards": [
    {
      "dot": "emerald",
      "title": "Ciclo diário",
      "items": [
        "Para cada repo ativo: GET /repos/{owner}/{repo}",
        "200 → fetch para refs/incoming, compara, aplica localmente (sem 2º fetch)",
        "Servidor desligado no horário → backup de recuperação ao iniciar (>23h)"
      ]
    },
    {
      "dot": "rose",
      "title": "Detecção de remoção",
      "items": [
        "404 em 2 ciclos seguidos → status 'sumiu' + email",
        "Volta a 200 → 'voltou' + email com dias fora",
        "Erro de rede/auth não conta como sumiço"
      ]
    },
    {
      "dot": "violet",
      "title": "Histórico protegido",
      "items": [
        "Force-push, branch apagada ou tag movida → cópia em refs/backup/<data>/",
        "Mirror criado de forma atômica e nunca apagado pelo sistema"
      ]
    },
    {
      "dot": "amber",
      "title": "Alertas por email",
      "items": [
        "Sumiu / voltou / falhando há 3 ciclos, agrupados por execução",
        "Envio falhou → tenta de novo no próximo ciclo",
        "Resumo semanal (domingo)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Segurança",
      "items": [
        "UI sem login: só 127.0.0.1 ou LAN/VPN",
        "POST de outro site bloqueado; hosts limitados por ALLOWED_HOSTS",
        "Token via env do git, nunca em disco nem em mensagens de erro"
      ]
    }
  ]
