# GitHub fine-grained PAT: Repository access = the repos to back up,
# permissions Contents: Read-only + Metadata: Read-only.
GITHUB_TOKEN=github_pat_xxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=you@gmail.com
# Gmail: use an App Password, not your account password.
SMTP_PASSWORD=app-password
MAIL_FROM=you@gmail.com
# Required, must not be empty. Comma-separated for several recipients.
MAIL_TO=you@gmail.com

# Optional. Standard cron syntax (day-of-week: 0 or 7 = Sunday).
SYNC_CRON=0 3 * * *
SUMMARY_CRON=0 9 * * 0
TZ=America/Sao_Paulo

# Optional. Comma-separated Host names the web UI accepts (blocks DNS rebinding).
# When binding to a LAN/Tailscale IP, add it here. Always keep 127.0.0.1: the
# Docker healthcheck uses it.
ALLOWED_HOSTS=127.0.0.1,localhost
