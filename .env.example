# GitHub fine-grained token: https://github.com/settings/personal-access-tokens/new
# Repository access = the repos to back up (Public repositories for others' public repos),
# permissions Contents: Read-only + Metadata: Read-only.
GITHUB_TOKEN=github_pat_xxx

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=you@gmail.com
# Gmail: use an App Password, not your account password.
SMTP_PASSWORD=app-password
MAIL_FROM=you@gmail.com
# Required, must not be empty. Comma-separated for several recipients.
MAIL_TO=you@gmail.com

# Optional. Standard cron syntax (day-of-week: 0 or 7 = Sunday).
SYNC_CRON=0 3 * * *
SUMMARY_CRON=0 9 * * 0
TZ=America/Sao_Paulo

# Optional. Where the web UI is published on the host.
#   127.0.0.1 = only this machine (default).
#   0.0.0.0   = every interface, e.g. other PCs on your LAN. The UI has no login, so only
#               do this on a trusted network / behind a firewall, never on the open internet.
#   <LAN IP>  = only that interface (e.g. 192.168.0.10 or your Tailscale IP).
BIND_ADDR=127.0.0.1
HOST_PORT=8808

# Optional. Comma-separated host names / IPs you type in the browser to open the UI
# (blocks DNS rebinding). Opening from another PC? Add the server's LAN IP and/or hostname,
# e.g. 127.0.0.1,localhost,192.168.0.10,marte,git-bkp.local.robsonv.com (reverse-proxy domain).
# Always keep 127.0.0.1: the Docker healthcheck uses it.
ALLOWED_HOSTS=127.0.0.1,localhost
